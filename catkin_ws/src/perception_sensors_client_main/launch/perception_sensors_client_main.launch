<launch>
    <!--
      感知传感器一键启动。

      依次拉起：激光雷达驱动 + 预处理、超声波雷达、UWB、bag_recorder，
      最后启动上装电源联动节点。联动节点只订阅
      /chassis_msg（common_msgs/ChassisMsg），按 chassis_relay_ctrl.tops_power_enable
      调用 /perception_sensors/start_bag_recorder、/perception_sensors/stop_bag_recorder。
    -->

    <!-- 超声波网关地址（现场网络可能不同） -->
    <arg name="gateway_ip" default="192.168.1.15" doc="超声波 Modbus 网关 IP"/>

    <!-- bag_recorder 参数，含义见 bag_recorder.launch -->
    <arg name="save_dir" default="" doc="bag 保存目录；留空表示仓库根目录的 log/rosbag"/>
    <arg name="max_bag_size_gb" default="25.0" doc="单次录制总大小上限（GB）"/>
    <arg name="total_limit_action" default="stop" doc="超过总上限时的动作：stop / delete_old"/>
    <arg name="max_dir_size_gb" default="150.0" doc="保存目录所有批次总大小高水位（GB）"/>
    <arg name="dir_low_watermark_gb" default="130.0" doc="目录清理目标低水位（GB）"/>

    <!-- UWB 串口名在 uwb_rtu_serial_demo/launch/uwb_node.launch 内配置 -->

    <!-- ================= 1. 激光雷达 ================= -->
    <include file="$(find lidar_preprocess)/launch/lidar_preprocess.launch"/>

    <!-- ================= 2. 超声波雷达 ================= -->
    <include file="$(find ultrasonic_radar_modbus_tcp)/launch/ultrasonic_radar_modbus_tcp.launch">
        <arg name="gateway_ip" value="$(arg gateway_ip)"/>
    </include>

    <!-- ================= 3. UWB 基站 ================= -->
    <!-- 顶层一键启动是旁路采集，独立采集系统必须显式打开主动采集 -->
    <include file="$(find uwb_rtu_serial_demo)/launch/uwb_node.launch">
        <arg name="uwb_self_collect" value="false"/>
    </include>

    <!-- ================= 4. rosbag 录制控制 ================= -->
    <include file="$(find bag_recorder)/launch/bag_recorder.launch">
        <arg name="save_dir" value="$(arg save_dir)"/>
        <arg name="max_bag_size_gb" value="$(arg max_bag_size_gb)"/>
        <arg name="total_limit_action" value="$(arg total_limit_action)"/>
        <arg name="max_dir_size_gb" value="$(arg max_dir_size_gb)"/>
        <arg name="dir_low_watermark_gb" value="$(arg dir_low_watermark_gb)"/>
    </include>

    <!-- ================= 5. 上装电源联动 ================= -->
    <node name="perception_sensors_client_main"
          pkg="perception_sensors_client_main"
          type="perception_sensors_client_main_node"
          output="screen"/>
</launch>
