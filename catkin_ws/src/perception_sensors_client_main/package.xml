<?xml version="1.0"?>
<package format="2">
  <name>perception_sensors_client_main</name>
  <version>0.0.0</version>
  <description>一键启动感知传感器节点，并把底盘保存按键状态联动到 bag_recorder</description>

  <maintainer email="root@todo.todo">root</maintainer>
  <license>TODO</license>

  <buildtool_depend>catkin</buildtool_depend>

  <!-- 本节点只用到 ROS 通信原语 -->
  <depend>roscpp</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>

  <!-- 顶层 launch 会 include 这些包 -->
  <exec_depend>lidar_preprocess</exec_depend>
  <exec_depend>ultrasonic_radar_modbus_tcp</exec_depend>
  <exec_depend>uwb_rtu_serial_demo</exec_depend>
  <exec_depend>bag_recorder</exec_depend>

  <export>
  </export>
</package>
